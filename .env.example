# Copy to .env (repo root or backend/). Every variable below is read by backend/app/config.py.
# Names are case-insensitive. Nothing here is required for the offline demo: the defaults run in replay mode.

# --- TinyFish ---------------------------------------------------------------------------------------------
# replay = read fixtures from backend/fixtures/tinyfish (no network, no key). live = call TinyFish.
TINYFISH_MODE=replay
TINYFISH_API_KEY=
# 1 = in live mode, save every response as a fixture so it can be replayed later.
TINYFISH_RECORD=0
# Hard caps for one server process. Agent runs cost credits; search and fetch are counted too.
TINYFISH_BUDGET_AGENT_RUNS=10
TINYFISH_BUDGET_FREE_CALLS=200
# TinyFish allows 2 concurrent Agent runs on our plan; extra runs queue.
TINYFISH_MAX_CONCURRENT_RUNS=2
# TinyFish does not sign webhooks. Put this token in the webhook URL: https://<host>/webhooks/tinyfish?token=<value>
TINYFISH_WEBHOOK_TOKEN=
TINYFISH_CACHE_TTL_SECONDS=3600

# --- Database ---------------------------------------------------------------------------------------------
# sqlite (default, file at SQLITE_PATH) or supabase (PostgREST; create tables with docs/supabase.sql).
DB_BACKEND=sqlite
SQLITE_PATH=./data/khetkaaj.db
SUPABASE_URL=
SUPABASE_KEY=

# --- Demo area and safety gate ----------------------------------------------------------------------------
# Placeholders until the Sell lane picks the real district in docs/sources.md.
DEMO_STATE=Uttar Pradesh
DEMO_DISTRICT=Meerut
# Below this confidence an answer is withheld and handed to a human.
CONFIDENCE_THRESHOLD=0.85

# --- Channels (the web/WhatsApp lane uses these) ----------------------------------------------------------
PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:5173
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
BHASHINI_USER_ID=
BHASHINI_API_KEY=
# Default voice-note language for senders without a saved farmer profile (hi or en).
BHASHINI_LANGUAGE=hi
# Remove WhatsApp idempotency metadata and cached replies older than this many days.
WHATSAPP_MESSAGE_RETENTION_DAYS=7

# Optional LLM phrasing of replies. Off by default; templates are used otherwise.
LLM_PHRASING=0
# Used only when LLM_PHRASING=1. The model sees finished template text, never web pages.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
